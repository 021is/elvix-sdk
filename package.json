{
  "name": "@elvix.is/sdk",
  "version": "0.16.0",
  "description": "Official elvix SDK. Drop-in React components, server helpers, and an MCP server so AI coding agents integrate elvix on the first try.",
  "license": "MIT",
  "homepage": "https://elvix.is",
  "author": {
    "name": "edvone",
    "url": "https://edvone.dev"
  },
  "funding": "https://edvone.dev/book",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/021is/elvix-sdk.git"
  },
  "bugs": "https://github.com/021is/elvix-sdk/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "elvix": "./dist/cli/index.js",
    "elvix-mcp": "./dist/mcp/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsup src/index.ts src/react.ts src/server.ts src/types.ts src/mcp/index.ts src/mcp/bin.ts src/cli/index.ts src/cli/doctor.ts src/cli/login.ts --format esm --dts --clean --external react --external react/jsx-runtime --external react-dom --external next && bun run build:css && node scripts/postbuild.mjs",
    "build:css": "tailwindcss --input src/styles/sdk.css --output dist/styles.css --minify",
    "lint": "biome check src tests",
    "lint:ci": "biome ci --error-on-warnings src tests",
    "lint:fix": "biome check --write src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=15",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "overrides": {
    "fast-uri": ">=3.1.6",
    "hono": ">=4.12.34",
    "@hono/node-server": ">=1.19.15",
    "proxy-addr": ">=2.0.8",
    "body-parser": ">=2.3.0",
    "ip-address": ">=10.3.1",
    "qs": ">=6.15.4",
    "nanoid": ">=3.3.16",
    "postcss": ">=8.5.23",
    "esbuild": ">=0.28.1",
    "source-map-js": ">=1.2.2"
  },
  "dependencies": {
    "@021.is/spine-i18n": "^0.4.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react-easy-crop": "^5.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/cli": "^4",
    "fake-indexeddb": "6.2.5",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26",
    "tailwindcss": "^4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "elvix",
    "authentication",
    "auth",
    "passkey",
    "otp",
    "google-oauth",
    "react",
    "nextjs",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ]
}
